# Copy to .env. Every variable read by crates/api/src/config.rs and mail_config.rs.
# Secrets: `openssl rand -base64 48` (min length enforced; placeholders are rejected at startup).

# --- required ---
DATABASE_URL=postgres://deskpost:CHANGE_ME@localhost:5432/deskpost
JWT_SECRET=
# must differ from JWT_SECRET; seals stored SMTP/IMAP passwords
DP_SECRET_KEY=

# --- core ---
# production (default) | development
DP_ENV=production
PORT=3000
# routes live under /api/<API_VERSION>; keep NEXT_PUBLIC_API_VERSION equal
API_VERSION=v3
# comma-separated CORS origins
FRONTEND_URL=https://desk.example.com
# default: true in production, false in development
COOKIE_SECURE=
# comma-separated IPs/CIDRs of your reverse proxy, e.g. 127.0.0.1
DP_TRUSTED_PROXIES=
# dev default; production: /var/lib/deskpost/storage (image and systemd unit set it, an env file value wins)
STORAGE_DIR=./data/storage
# default false; true opens public POST /auth/signup
DP_ALLOW_SIGNUP=false
# true: with signup open, the first account becomes global admin (prefer `deskpost bootstrap`)
DP_FIRST_USER_ADMIN=false
# true only for local mail servers (mailpit, greenmail)
DP_ALLOW_PRIVATE_MAIL_HOSTS=false

# --- request limits (bytes) ---
DP_BODY_LIMIT_BYTES=65536
DP_UPLOAD_LIMIT_BYTES=27262976
DP_WEBHOOK_LIMIT_BYTES=37748736

# --- mail ---
# optional; enables the signed inbound webhook (same strength rules)
DP_WEBHOOK_SECRET=
DP_MAIL_PLAINTEXT=false
DP_MAX_FILE_BYTES=10485760
DP_MAX_REQUEST_BYTES=26214400
DP_MAX_FILES=20
DP_IMAP_POLL_SECS=60
DP_IMAP_CONCURRENCY=4

# --- first admin (deskpost bootstrap subcommand) ---
DP_BOOTSTRAP_PASSWORD=

# --- system mail (password reset; needs FRONTEND_URL; empty host = reset off) ---
DP_SYSTEM_SMTP_HOST=
DP_SYSTEM_SMTP_PORT=
DP_SYSTEM_SMTP_USER=
DP_SYSTEM_SMTP_PASSWORD=
DP_SYSTEM_SMTP_FROM=

# --- logging ---
RUST_LOG=info

# --- compose / web only ---
POSTGRES_PASSWORD=
# leave empty: UI and API share one origin (web image proxies /api). Baked in as NEXT_PUBLIC_API_URL
PUBLIC_URL=
# multiplies per-address rate limits; only raise for load tests
DP_RATE_LIMIT_SCALE=1
