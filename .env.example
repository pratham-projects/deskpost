# Copy to .env. Every variable read by crates/api/src/config.rs and mail_config.rs.
# Secrets: `openssl rand -base64 48` (min length enforced; placeholders are rejected at startup).

# --- required ---
DATABASE_URL=postgres://deskpost:CHANGE_ME@localhost:5432/deskpost
JWT_SECRET=
DP_SECRET_KEY=          # must differ from JWT_SECRET; seals stored SMTP/IMAP passwords

# --- core ---
DP_ENV=production       # production (default) | development
PORT=3000
API_VERSION=v3          # routes live under /api/<API_VERSION>; keep NEXT_PUBLIC_API_VERSION equal
FRONTEND_URL=https://desk.example.com   # comma-separated CORS origins
COOKIE_SECURE=          # default: true in production, false in development
DP_TRUSTED_PROXIES=     # comma-separated IPs/CIDRs of your reverse proxy, e.g. 127.0.0.1
STORAGE_DIR=./data/storage   # dev default; production: /var/lib/deskpost/storage (image and systemd unit set it, an env file value wins)
DP_ALLOW_SIGNUP=false   # default false; true opens public POST /auth/signup
DP_FIRST_USER_ADMIN=false   # true: with signup open, the first account becomes global admin (prefer `api bootstrap`)
DP_ALLOW_PRIVATE_MAIL_HOSTS=false   # true only for local mail servers (mailpit, greenmail)

# --- request limits (bytes) ---
DP_BODY_LIMIT_BYTES=65536
DP_UPLOAD_LIMIT_BYTES=27262976
DP_WEBHOOK_LIMIT_BYTES=37748736

# --- mail ---
DP_WEBHOOK_SECRET=      # optional; enables the signed inbound webhook (same strength rules)
DP_MAIL_PLAINTEXT=false
DP_MAX_FILE_BYTES=10485760
DP_MAX_REQUEST_BYTES=26214400
DP_MAX_FILES=20
DP_IMAP_POLL_SECS=60
DP_IMAP_CONCURRENCY=4

# --- first admin (api bootstrap subcommand) ---
DP_BOOTSTRAP_PASSWORD=

# --- system mail (password reset; needs FRONTEND_URL; empty host = reset off) ---
DP_SYSTEM_SMTP_HOST=
DP_SYSTEM_SMTP_PORT=
DP_SYSTEM_SMTP_USER=
DP_SYSTEM_SMTP_PASSWORD=
DP_SYSTEM_SMTP_FROM=

# --- logging ---
RUST_LOG=info

# --- compose / web only ---
POSTGRES_PASSWORD=
PUBLIC_URL=                             # leave empty: UI and API share one origin (web image proxies /api). Baked in as NEXT_PUBLIC_API_URL
DP_RATE_LIMIT_SCALE=1   # multiplies per-address rate limits; only raise for load tests
