# Copy to .env. Every variable read by crates/api/src/config.rs and mail_config.rs.
# Secrets: `openssl rand -base64 48` (min length enforced; placeholders are rejected at startup).

# --- required ---
DATABASE_URL=postgres://senddesk:CHANGE_ME@localhost:5432/senddesk
JWT_SECRET=
SD_SECRET_KEY=          # must differ from JWT_SECRET; seals stored SMTP/IMAP passwords

# --- core ---
SD_ENV=production       # production (default) | development
PORT=3000
API_VERSION=v3          # routes live under /api/<API_VERSION>; keep NEXT_PUBLIC_API_VERSION equal
FRONTEND_URL=https://desk.example.com   # comma-separated CORS origins
COOKIE_SECURE=          # default: true in production, false in development
SD_TRUSTED_PROXIES=     # comma-separated IPs/CIDRs of your reverse proxy, e.g. 127.0.0.1
STORAGE_DIR=./data/storage   # dev default; production: /var/lib/senddesk/storage (image and systemd unit set it, an env file value wins)
SD_ALLOW_SIGNUP=false   # default false; true opens public POST /auth/signup
SD_FIRST_USER_ADMIN=false   # true: with signup open, the first account becomes global admin (prefer `api bootstrap`)
SD_ALLOW_PRIVATE_MAIL_HOSTS=false   # true only for local mail servers (mailpit, greenmail)

# --- request limits (bytes) ---
SD_BODY_LIMIT_BYTES=65536
SD_UPLOAD_LIMIT_BYTES=27262976
SD_WEBHOOK_LIMIT_BYTES=37748736

# --- mail ---
SD_WEBHOOK_SECRET=      # optional; enables the signed inbound webhook (same strength rules)
SD_MAIL_PLAINTEXT=false
SD_MAX_FILE_BYTES=10485760
SD_MAX_REQUEST_BYTES=26214400
SD_MAX_FILES=20
SD_IMAP_POLL_SECS=60
SD_IMAP_CONCURRENCY=4

# --- first admin (api bootstrap subcommand) ---
SD_BOOTSTRAP_PASSWORD=

# --- logging ---
RUST_LOG=info

# --- compose / web only ---
POSTGRES_PASSWORD=
PUBLIC_URL=                             # leave empty: UI and API share one origin (web image proxies /api). Baked in as NEXT_PUBLIC_API_URL
